{
  "name": "@xaiverdeng/ssos",
  "version": "2.1.9",
  "description": "StartupOS AI Tools - One-line install for CLI, MCP Servers, and Skills",
  "type": "module",
  "bin": {
    "startupos": "./cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "cli/dist/**",
    "mcp-suite/packages/accounting/dist",
    "mcp-suite/packages/accounting/package.json",
    "mcp-suite/packages/accounting-utils/dist",
    "mcp-suite/packages/accounting-utils/package.json",
    "mcp-suite/packages/ai/dist",
    "mcp-suite/packages/ai/package.json",
    "mcp-suite/packages/core/dist",
    "mcp-suite/packages/core/package.json",
    "mcp-suite/packages/hr/dist",
    "mcp-suite/packages/hr/package.json",
    "mcp-suite/packages/legal/dist",
    "mcp-suite/packages/legal/package.json",
    "mcp-suite/packages/shared/dist",
    "mcp-suite/packages/shared/package.json",
    "skills",
    "README.md",
    "LICENSE",
    "cli/package.json",
    "cli/package-lock.json"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:mcp",
    "build:cli": "cd cli && npm install && npm run build",
    "build:mcp": "cd mcp-suite && npm install && npm run build",
    "prepublishOnly": "npm run build",
    "postinstall": "echo \"⚙️  Setting up @xaiverdeng/ssos...\"\ncd cli && npm install --omit=dev && cd .. | true"
  },
  "keywords": [
    "startupos",
    "创业os",
    "financial-management",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-native",
    "claude-code"
  ],
  "author": "StartupOS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xaiver03/startupos-ai-tools.git"
  },
  "homepage": "https://github.com/Xaiver03/startupos-ai-tools#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "table": "^6.8.1"
  }
}
